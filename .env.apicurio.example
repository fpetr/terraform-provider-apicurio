# Apicurio images
APICURIO_REGISTRY_TAG=3.1.3
APICURIO_UI_TAG=3.1.3

# Postgres
POSTGRES_DB=apicurio
POSTGRES_USER=apicurio
POSTGRES_PASSWORD=apicurio

# OIDC / Keycloak
OIDC_AUTH_SERVER_URL=https://login.example.com/realms/<realm>

# Client IDs (create separate clients for API and UI)
OIDC_API_CLIENT_ID=apicurio-registry-api
OIDC_UI_CLIENT_ID=apicurio-registry-ui

# UI redirect URL (must match the UI client config in Keycloak)
OIDC_REDIRECT_URL=http://localhost:8888

# UI -> API URL used by the browser
REGISTRY_API_URL=http://localhost:8080/apis/registry/v3

# Optional Apicurio REST flags
APICURIO_REST_MUTABILITY_ARTIFACT_VERSION_CONTENT_ENABLED=true
APICURIO_REST_DELETION_ARTIFACT_ENABLED=true
APICURIO_REST_DELETION_ARTIFACT_VERSION_ENABLED=true
APICURIO_REST_DELETION_GROUP_ENABLED=true
